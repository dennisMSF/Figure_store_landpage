# Copia este archivo a .env y completa tus valores:  cp .env.example .env
# Nunca subas .env al repositorio (ya está en .gitignore).

# anthropic | ollama
LLM_PROVIDER=anthropic

# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_FAST_MODEL=claude-haiku-5-5

# Ollama (app nativa de macOS, usa la GPU del M1 vía Metal)
OLLAMA_HOST=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2:3b
OLLAMA_EMBED_MODEL=nomic-embed-text

# Opcional: trazas de LLM con Langfuse (https://cloud.langfuse.com)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

LOG_LEVEL=INFO
ENVIRONMENT=dev
